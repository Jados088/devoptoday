
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'npm test'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Application tests passed!'
        }

        failure {
            echo 'FAILURE: Jenkins pipeline failed!'
        }
    }
}
